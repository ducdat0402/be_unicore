{
    "Database": {
        "Provider": "SQL Server",
        "ConnectionString": "Data Source=YOUR_SERVER;Initial Catalog=UniCoreDatabase;Persist Security Info=False;User ID=sa;Password=YOUR_PASSWORD;Pooling=False;MultipleActiveResultSets=False;Connect Timeout=60;Encrypt=True;TrustServerCertificate=True",
        "AutoMigrate": false,
        "EnableSensitiveDataLogging": false,
        "CommandTimeout": 30,
        "MaxRetryCount": 3,
        "MaxRetryDelay": 30,
        "EnableQuerySplitting": true,
        "PoolSize": 128,
        "EnableHealthChecks": true,
        "HealthCheckInterval": 5
    },
    "AllowedHosts": "*",
    "Jwt": {
        "Secret": "YOUR_JWT_SUPER_SECRET_KEY_MUST_BE_AT_LEAST_256_BITS_LONG_123456",
        "Issuer": "UniCore",
        "Audience": "UniCore-Users",
        "TokenExpireMinutes": 60,
        "RefreshTokenExpireDays": 7
    }
}
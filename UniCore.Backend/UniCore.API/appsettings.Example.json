{
    "Database": {
        "Provider": "SQL Server",
        "ConnectionString": "Data Source=YOUR_SERVER;Initial Catalog=UniCoreDatabase;Persist Security Info=False;User ID=sa;Password=YOUR_PASSWORD;Pooling=False;MultipleActiveResultSets=False;Connect Timeout=60;Encrypt=True;TrustServerCertificate=True",
        "AutoMigrate": false,
        "EnableSensitiveDataLogging": false,
        "CommandTimeout": 30,
        "MaxRetryCount": 3,
        "MaxRetryDelay": 30,
        "EnableQuerySplitting": true,
        "PoolSize": 128,
        "EnableHealthChecks": true,
        "HealthCheckInterval": 5
    },
    "AllowedHosts": "*",
    "Jwt": {
        "Secret": "YOUR_JWT_SUPER_SECRET_KEY_MUST_BE_AT_LEAST_256_BITS_LONG_123456",
        "Issuer": "UniCore",
        "Audience": "UniCore-Users",
        "TokenExpireMinutes": 60,
        "RefreshTokenExpireDays": 7
    },
    "Email": {
        "Enabled": false,
        "Host": "smtp.example.com",
        "Port": 587,
        "EnableSsl": true,
        "Username": "",
        "Password": "",
        "FromAddress": "noreply@unicore.local",
        "FromDisplayName": "UniCore Announcements"
    },
    "AiOcr": {
        "BaseUrl": "http://127.0.0.1:8000",
        "ScanPath": "/ocr",
        "ImageFieldName": "file",
        "UserIdFieldName": "",
        "TimeoutSeconds": 60,
        "MaxImageBytes": 10485760
    },
    "FaceAi": {
        "BaseUrl": "http://127.0.0.1:8001",
        "EnrollPath": "/ai/face/enroll",
        "RecognizePath": "/ai/face/recognize",
        "TimeoutSeconds": 120,
        "MaxImageBytes": 10485760,
        "SimilarityThreshold": 0.80,
        "ChallengeMinutes": 5,
        "RateLimit": {
            "MaxLoginAttemptsPerIp": 10,
            "MaxLoginAttemptsPerUser": 5,
            "WindowMinutes": 1
        }
    }
}
